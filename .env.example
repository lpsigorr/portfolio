# Copy this file to .env and fill in your own values. Never commit .env.

# EmailJS (contact form)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "I'm not a robot" checkbox: the public SITE key only.
# Leave empty to run without the checkbox (a hidden honeypot field is still used).
VITE_RECAPTCHA_SITE_KEY=
